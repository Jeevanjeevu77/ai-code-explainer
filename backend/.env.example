# =====================================================
# AI Code Explainer - Environment Variables
# =====================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit your .env file to version control!
# It's already in .gitignore to keep your keys safe.
# =====================================================

# Your OpenAI API key
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_api_key_here

# The AI model to use
# Options: gpt-4o-mini (cheapest), gpt-4o (smarter), gpt-3.5-turbo (older)
AI_MODEL=gpt-4o-mini

# The API base URL
# Default is OpenAI. Change this to use other providers:
# - Anthropic Claude: https://api.anthropic.com/v1 (with compatible mode)
# - Groq: https://api.groq.com/openai/v1
# - OpenRouter: https://openrouter.ai/api/v1
# - Local Ollama: http://localhost:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1
